{
  "name": "needlewhile",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "An opt-in tactile yarn-ball waiting toy for local AI agent clients.",
  "scripts": {
    "demo": "node skills/needlewhile/scripts/lifecycle.mjs start --client demo --verbose && node skills/needlewhile/scripts/lifecycle.mjs open --verbose",
    "open": "node skills/needlewhile/scripts/lifecycle.mjs open --verbose",
    "stop": "node skills/needlewhile/scripts/lifecycle.mjs stop --client demo --verbose",
    "status": "node skills/needlewhile/scripts/lifecycle.mjs status --verbose",
    "shutdown": "node skills/needlewhile/scripts/lifecycle.mjs shutdown --verbose",
    "test:openai-app": "node adapters/openai-app/self-test.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
