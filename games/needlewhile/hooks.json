{
  "description": "Track Codex task state for Needlewhile without opening or taking over a browser.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs\" start --client codex",
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%\\skills\\needlewhile\\scripts\\lifecycle.mjs\" start --client codex",
            "timeout": 5,
            "statusMessage": "Tracking Needlewhile quietly"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs\" heartbeat --client codex",
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%\\skills\\needlewhile\\scripts\\lifecycle.mjs\" heartbeat --client codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs\" stop --client codex",
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%\\skills\\needlewhile\\scripts\\lifecycle.mjs\" stop --client codex",
            "timeout": 5,
            "statusMessage": "Letting the pins rest"
          }
        ]
      }
    ]
  }
}
