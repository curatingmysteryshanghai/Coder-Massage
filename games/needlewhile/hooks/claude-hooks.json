{
  "description": "Track Claude Code task state for Needlewhile without opening or taking over a browser.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs",
              "start",
              "--client",
              "claude-code"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs",
              "heartbeat",
              "--client",
              "claude-code"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs",
              "stop",
              "--client",
              "claude-code"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs",
              "error",
              "--client",
              "claude-code"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/needlewhile/scripts/lifecycle.mjs",
              "cleanup",
              "--client",
              "claude-code"
            ],
            "timeout": 1
          }
        ]
      }
    ]
  }
}
